# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# auditorias Gemini locais (não entram no build da Vercel)
scripts/_audit-*
scripts/_limpar-*
scripts/_w_*
scripts/seed-juris-diario.log
scripts/testes-pecas-diario.log

# saídas locais de teste de peça (não commit)
/tmp/

